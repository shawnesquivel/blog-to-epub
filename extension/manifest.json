{
  "manifest_version": 3,
  "name": "Blog to EPUB",
  "version": "1.0.0",
  "description": "Convert the article you're reading into an EPUB for Apple Books.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Convert this article to EPUB"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "sandbox": {
    "pages": ["sandbox.html"]
  },
  "permissions": ["activeTab", "scripting", "downloads"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
